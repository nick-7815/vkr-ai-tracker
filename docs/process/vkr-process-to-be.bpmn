    <bpmn:sequenceFlow id="Flow_12" sourceRef="Task_NewTopic" targetRef="Gateway_TopicJoin" />
    <bpmn:sequenceFlow id="Flow_13" sourceRef="Task_AdjustTopic" targetRef="Gateway_TopicJoin" />
