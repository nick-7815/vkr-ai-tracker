<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
                  xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL"
                  xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI"
                  xmlns:dc="http://www.omg.org/spec/DD/20100524/DC"
                  xmlns:di="http://www.omg.org/spec/DD/20100524/DI"
                  id="Definitions_VKR_ToBe" targetNamespace="http://bpmn.io/schema/bpmn"
                  exporter="docs/process/lib/bpmn-builder.js" exporterVersion="1.0">
  <bpmn:category id="Category_1">
    <bpmn:categoryValue id="CategoryValue_1" value="Этап 1. Каталог тем и подача студентов" />
  </bpmn:category>
  <bpmn:category id="Category_2">
    <bpmn:categoryValue id="CategoryValue_2" value="Этап 2. Проект приказа и приказ" />
  </bpmn:category>
  <bpmn:category id="Category_3">
    <bpmn:categoryValue id="CategoryValue_3" value="Этап 3. Источники, просмотры, ревью кода" />
  </bpmn:category>
  <bpmn:category id="Category_4">
    <bpmn:categoryValue id="CategoryValue_4" value="Этап 4. Допуск: нормоконтроль по PDF и антиплагиат" />
  </bpmn:category>
  <bpmn:category id="Category_5">
    <bpmn:categoryValue id="CategoryValue_5" value="Этап 5. Предзащита, подписи и защита" />
  </bpmn:category>
  <bpmn:collaboration id="Collaboration_1">
    <bpmn:documentation>Целевой процесс: маршрут ведёт ВКР-трекер, проверки литературы, кода и текста автоматизированы.</bpmn:documentation>
    <bpmn:participant id="Participant_1" name="Кафедра: выполнение и защита ВКР с ВКР-трекером" processRef="Process_1" />
    <bpmn:participant id="Participant_Rectorate" name="Ректорат: подписание приказа" />
    <bpmn:participant id="Participant_Meta" name="Внешние источники метаданных: Crossref, eLIBRARY, каталоги библиотек" />
    <bpmn:participant id="Participant_Library" name="Библиотека: проверка и подпись списка литературы" />
    <bpmn:messageFlow id="MessageFlow_OrderOut" name="Проект приказа на подпись" sourceRef="Task_CheckOrder" targetRef="Participant_Rectorate" />
    <bpmn:messageFlow id="MessageFlow_OrderBack" name="Подписанный приказ или замечания" sourceRef="Participant_Rectorate" targetRef="Event_OrderReply" />
    <bpmn:messageFlow id="MessageFlow_MetaOut" name="Запрос по DOI, ISBN или URL" sourceRef="Task_RefResolve" targetRef="Participant_Meta" />
    <bpmn:messageFlow id="MessageFlow_MetaBack" name="Метаданные источника" sourceRef="Participant_Meta" targetRef="Task_RefResolve" />
    <bpmn:messageFlow id="MessageFlow_BibOut" name="Список литературы" sourceRef="Task_SendBibLibrary" targetRef="Participant_Library" />
    <bpmn:messageFlow id="MessageFlow_BibBack" name="Подписанный список" sourceRef="Participant_Library" targetRef="Event_BibSigned" />
  </bpmn:collaboration>
  <bpmn:process id="Process_1" name="Выполнение и защита ВКР («как надо»)" isExecutable="false">
    <bpmn:documentation>Модель «как надо»: цикл открывает заместитель заведующего по учебной части — выбирает окна регламента и даты, дальше сроки и напоминания ведёт система; каталог тем и приказ формируются автоматически, источники проходят рефчекер с выдачей описания по ГОСТ Р 7.0.5-2008, код приходит архивом и проверяется LLM, текст принимается в PDF и разбирается автоматически плюс сверяется LLM с методичкой. За людьми остаются антиплагиат, просмотры, предзащита, подписи и защита.</bpmn:documentation>
    <bpmn:laneSet id="LaneSet_1">
      <bpmn:lane id="Lane_Deputy" name="Заместитель заведующего по учебной части">
        <bpmn:flowNodeRef>StartEvent_Cycle</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_InitCycle</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>SubProcess_DateChange</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_Secretary" name="Секретарь кафедры">
        <bpmn:flowNodeRef>Task_CheckOrder</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Event_OrderReply</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gateway_Signed</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_PublishOrder</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Event_OrderPublished</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_Teacher" name="Руководитель ВКР">
        <bpmn:flowNodeRef>Task_CollectTopics</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_AdjustTopic</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_SubmitStudent</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_FixTopic</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_TeacherReviewCode</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_Student" name="Студент">
        <bpmn:flowNodeRef>Task_StudentReview</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gateway_TopicChoice</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_PickTopic</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_NewTopic</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gateway_TopicJoin</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>SubProcess_TopicChange</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Event_EndSemester</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_AddSource</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_AddMore</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_UploadCode</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_FixCode</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_PrepareDocs</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_UploadPdf</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_FixNorm</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_FixText</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_FixAfterPre</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_SendBibLibrary</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Event_BibSigned</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_BindWork</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gateway_PdfMerge</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gateway_SourceMerge</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_System" name="ВКР-трекер: автопроверки, LLM, уведомления">
        <bpmn:flowNodeRef>Task_ScheduleCalendar</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_SuggestTopics</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_PublishCatalog</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_GenOrder</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_NotifyFix</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_RefResolve</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_RefCheck</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gateway_BibOk</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_ReviewersPick</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_NotifyScreening</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gateway_LateMerge</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_RemindLate</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>EndEvent_Reminded</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Event_BeforePredef</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_LlmCodeReview</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_ParseWork</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_LlmNormControl</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gateway_NormOk</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_CollectPackage</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gateway_OrderMerge</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_Board" name="Другие преподаватели (просмотры, предзащита, защита)">
        <bpmn:flowNodeRef>Event_Screen1Date</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_Screening1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Boundary_Screen1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Event_Screen2Date</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_Screening2</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Boundary_Screen2</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Event_PredefDate</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_Predefense</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gateway_Admitted</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_Defense</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>EndEvent_Done</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gateway_PredefMerge</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_Norm" name="Нормоконтролёр">
        <bpmn:flowNodeRef>Task_NormConfirm</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_Antiplagiat</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gateway_PlagOk</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gateway_PlagMerge</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_Head" name="Заведующий кафедрой">
        <bpmn:flowNodeRef>Task_HeadSign</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="StartEvent_Cycle" name="Начался новый учебный год">
      <bpmn:outgoing>Flow_1</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:userTask id="Task_InitCycle" name="Запустить цикл: выбрать окна регламента и даты">
      <bpmn:documentation>Заместитель заведующего по учебной части открывает цикл в системе: выбирает окна регламента и при необходимости правит конкретные даты.</bpmn:documentation>
      <bpmn:incoming>Flow_1</bpmn:incoming>
      <bpmn:outgoing>Flow_2</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:serviceTask id="Task_ScheduleCalendar" name="Расставить сроки этапов и напоминания">
      <bpmn:documentation>Система раскладывает даты по этапам, ставит дедлайны и планирует напоминания студентам, руководителям и рецензентам.</bpmn:documentation>
      <bpmn:incoming>Flow_2</bpmn:incoming>
      <bpmn:outgoing>Flow_3</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:subProcess id="SubProcess_DateChange" name="Изменение дат по ходу цикла" triggeredByEvent="true">
      <bpmn:startEvent id="SubProcess_DateChange_S" name="Нужно подвинуть дату" isInterrupting="false">
        <bpmn:outgoing>SubProcess_DateChange_F1</bpmn:outgoing>
        <bpmn:messageEventDefinition id="SubProcess_DateChange_S_def" />
      </bpmn:startEvent>
      <bpmn:userTask id="SubProcess_DateChange_T1" name="Выбрать этап и новое окно регламента">
        <bpmn:incoming>SubProcess_DateChange_F1</bpmn:incoming>
        <bpmn:outgoing>SubProcess_DateChange_F2</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="SubProcess_DateChange_T2" name="Пересчитать сроки и разослать уведомления">
        <bpmn:incoming>SubProcess_DateChange_F2</bpmn:incoming>
        <bpmn:outgoing>SubProcess_DateChange_F3</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:endEvent id="SubProcess_DateChange_E" name="Даты обновлены">
        <bpmn:incoming>SubProcess_DateChange_F3</bpmn:incoming>
      </bpmn:endEvent>
      <bpmn:sequenceFlow id="SubProcess_DateChange_F1" sourceRef="SubProcess_DateChange_S" targetRef="SubProcess_DateChange_T1" />
      <bpmn:sequenceFlow id="SubProcess_DateChange_F2" sourceRef="SubProcess_DateChange_T1" targetRef="SubProcess_DateChange_T2" />
      <bpmn:sequenceFlow id="SubProcess_DateChange_F3" sourceRef="SubProcess_DateChange_T2" targetRef="SubProcess_DateChange_E" />
    </bpmn:subProcess>
    <bpmn:serviceTask id="Task_SuggestTopics" name="Предложить темы прошлых лет к переносу">
      <bpmn:documentation>Трекер поднимает темы прошлых лет и предлагает руководителю перенести их в новый цикл.</bpmn:documentation>
      <bpmn:incoming>Flow_3</bpmn:incoming>
      <bpmn:outgoing>Flow_4</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:userTask id="Task_CollectTopics" name="Подтвердить перенос и вписать темы на выбор">
      <bpmn:documentation>Первый круг таблицы: преподаватели с дипломниками вписывают темы на выбор, без фамилий студентов.</bpmn:documentation>
      <bpmn:incoming>Flow_4</bpmn:incoming>
      <bpmn:outgoing>Flow_5</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:serviceTask id="Task_PublishCatalog" name="Опубликовать каталог тем и уведомить студентов">
      <bpmn:incoming>Flow_5</bpmn:incoming>
      <bpmn:outgoing>Flow_6</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:userTask id="Task_StudentReview" name="Изучить каталог и связаться с преподавателем">
      <bpmn:incoming>Flow_6</bpmn:incoming>
      <bpmn:outgoing>Flow_7</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:exclusiveGateway id="Gateway_TopicChoice" name="Как определяется тема?">
      <bpmn:incoming>Flow_7</bpmn:incoming>
      <bpmn:outgoing>Flow_8</bpmn:outgoing>
      <bpmn:outgoing>Flow_9</bpmn:outgoing>
      <bpmn:outgoing>Flow_10</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:userTask id="Task_PickTopic" name="Закрепить тему из каталога">
      <bpmn:incoming>Flow_8</bpmn:incoming>
      <bpmn:outgoing>Flow_11</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:userTask id="Task_NewTopic" name="Предложить свою тему">
      <bpmn:incoming>Flow_9</bpmn:incoming>
      <bpmn:outgoing>Flow_12</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:userTask id="Task_AdjustTopic" name="Уточнить формулировку под специфику">
      <bpmn:incoming>Flow_10</bpmn:incoming>
      <bpmn:outgoing>Flow_13</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:exclusiveGateway id="Gateway_TopicJoin">
      <bpmn:incoming>Flow_11</bpmn:incoming>
      <bpmn:incoming>Flow_12</bpmn:incoming>
      <bpmn:incoming>Flow_13</bpmn:incoming>
      <bpmn:outgoing>Flow_14</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:userTask id="Task_SubmitStudent" name="Подать студента и итоговую тему">
      <bpmn:documentation>Второй круг: преподаватель указывает фамилию студента и формулировку темы, которая пойдёт в диплом.</bpmn:documentation>
      <bpmn:incoming>Flow_14</bpmn:incoming>
      <bpmn:outgoing>Flow_15</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:serviceTask id="Task_GenOrder" name="Собрать проект приказа из поданных пар">
      <bpmn:documentation>Проект приказа собирается автоматически из пар «студент — тема»: номера тем, руководители, шифры ВКР. До подписи это проект.</bpmn:documentation>
      <bpmn:incoming>Flow_74</bpmn:incoming>
      <bpmn:outgoing>Flow_16</bpmn:outgoing>
      <bpmn:dataOutputAssociation id="DataOut_DataObj_OrderDraft">
        <bpmn:targetRef>DataObj_OrderDraft</bpmn:targetRef>
      </bpmn:dataOutputAssociation>
    </bpmn:serviceTask>
    <bpmn:sendTask id="Task_CheckOrder" name="Проверить проект и отправить в ректорат">
      <bpmn:incoming>Flow_16</bpmn:incoming>
      <bpmn:outgoing>Flow_17</bpmn:outgoing>
    </bpmn:sendTask>
    <bpmn:intermediateCatchEvent id="Event_OrderReply" name="Ответ из ректората">
      <bpmn:incoming>Flow_17</bpmn:incoming>
      <bpmn:outgoing>Flow_18</bpmn:outgoing>
      <bpmn:messageEventDefinition id="Event_OrderReply_def" />
    </bpmn:intermediateCatchEvent>
    <bpmn:userTask id="Task_FixTopic" name="Исправить формулировку темы">
      <bpmn:incoming>Flow_21</bpmn:incoming>
      <bpmn:outgoing>Flow_22</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:exclusiveGateway id="Gateway_Signed" name="Проект подписан?">
      <bpmn:incoming>Flow_18</bpmn:incoming>
      <bpmn:outgoing>Flow_19</bpmn:outgoing>
      <bpmn:outgoing>Flow_20</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:serviceTask id="Task_NotifyFix" name="Уведомить руководителя о замечании и поставить срок">
      <bpmn:incoming>Flow_20</bpmn:incoming>
      <bpmn:outgoing>Flow_21</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:userTask id="Task_PublishOrder" name="Опубликовать приказ и зафиксировать статусы тем">
      <bpmn:incoming>Flow_19</bpmn:incoming>
      <bpmn:outgoing>Flow_23</bpmn:outgoing>
      <bpmn:dataOutputAssociation id="DataOut_DataObj_Order">
        <bpmn:targetRef>DataObj_Order</bpmn:targetRef>
      </bpmn:dataOutputAssociation>
    </bpmn:userTask>
    <bpmn:intermediateThrowEvent id="Event_OrderPublished" name="Темы утверждены приказом">
      <bpmn:incoming>Flow_23</bpmn:incoming>
      <bpmn:outgoing>Flow_24</bpmn:outgoing>
    </bpmn:intermediateThrowEvent>
    <bpmn:subProcess id="SubProcess_TopicChange" name="Смена темы после приказа (по заявлению)" triggeredByEvent="true">
      <bpmn:startEvent id="SubProcess_TopicChange_S" name="Нужна смена темы" isInterrupting="false">
        <bpmn:outgoing>SubProcess_TopicChange_F1</bpmn:outgoing>
        <bpmn:messageEventDefinition id="SubProcess_TopicChange_S_def" />
      </bpmn:startEvent>
      <bpmn:userTask id="SubProcess_TopicChange_T1" name="Подать заявление на смену темы в системе">
        <bpmn:incoming>SubProcess_TopicChange_F1</bpmn:incoming>
        <bpmn:outgoing>SubProcess_TopicChange_F2</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="SubProcess_TopicChange_T2" name="Согласовать новую тему с руководителем">
        <bpmn:incoming>SubProcess_TopicChange_F2</bpmn:incoming>
        <bpmn:outgoing>SubProcess_TopicChange_F3</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="SubProcess_TopicChange_T3" name="Внести изменение в приказ">
        <bpmn:incoming>SubProcess_TopicChange_F3</bpmn:incoming>
        <bpmn:outgoing>SubProcess_TopicChange_F4</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:endEvent id="SubProcess_TopicChange_E" name="Тема изменена">
        <bpmn:incoming>SubProcess_TopicChange_F4</bpmn:incoming>
      </bpmn:endEvent>
      <bpmn:sequenceFlow id="SubProcess_TopicChange_F1" sourceRef="SubProcess_TopicChange_S" targetRef="SubProcess_TopicChange_T1" />
      <bpmn:sequenceFlow id="SubProcess_TopicChange_F2" sourceRef="SubProcess_TopicChange_T1" targetRef="SubProcess_TopicChange_T2" />
      <bpmn:sequenceFlow id="SubProcess_TopicChange_F3" sourceRef="SubProcess_TopicChange_T2" targetRef="SubProcess_TopicChange_T3" />
      <bpmn:sequenceFlow id="SubProcess_TopicChange_F4" sourceRef="SubProcess_TopicChange_T3" targetRef="SubProcess_TopicChange_E" />
    </bpmn:subProcess>
    <bpmn:intermediateCatchEvent id="Event_EndSemester" name="Конец первого семестра">
      <bpmn:incoming>Flow_24</bpmn:incoming>
      <bpmn:outgoing>Flow_25</bpmn:outgoing>
      <bpmn:timerEventDefinition id="Event_EndSemester_def" />
    </bpmn:intermediateCatchEvent>
    <bpmn:userTask id="Task_AddSource" name="Добавить источник: ссылку, DOI или ISBN">
      <bpmn:incoming>Flow_73</bpmn:incoming>
      <bpmn:outgoing>Flow_26</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:serviceTask id="Task_RefResolve" name="Рефчекер: найти метаданные и собрать описание по ГОСТ">
      <bpmn:documentation>Система тянет метаданные по DOI, ISBN или URL и отдаёт студенту готовое библиографическое описание по ГОСТ Р 7.0.5-2008 — его остаётся вставить в свой список литературы.</bpmn:documentation>
      <bpmn:incoming>Flow_26</bpmn:incoming>
      <bpmn:outgoing>Flow_27</bpmn:outgoing>
      <bpmn:dataOutputAssociation id="DataOut_DataObj_Sources">
        <bpmn:targetRef>DataObj_Sources</bpmn:targetRef>
      </bpmn:dataOutputAssociation>
    </bpmn:serviceTask>
    <bpmn:serviceTask id="Task_RefCheck" name="Проверить состав списка источников">
      <bpmn:documentation>Требования методички: не менее 30 источников, не менее 20 % зарубежных, обязательные базы — библиотека вуза, eLIBRARY, Scopus, интернет-источники. Ссылки в тексте сверяются позже, при разборе PDF.</bpmn:documentation>
      <bpmn:incoming>Flow_27</bpmn:incoming>
      <bpmn:outgoing>Flow_28</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:exclusiveGateway id="Gateway_BibOk" name="Список соответствует требованиям?">
      <bpmn:incoming>Flow_28</bpmn:incoming>
      <bpmn:outgoing>Flow_29</bpmn:outgoing>
      <bpmn:outgoing>Flow_30</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:userTask id="Task_AddMore" name="Дополнить список источников">
      <bpmn:incoming>Flow_30</bpmn:incoming>
      <bpmn:outgoing>Flow_31</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:serviceTask id="Task_ReviewersPick" name="Подобрать рецензентов: шаффл без повторов или предпочтения руководителя">
      <bpmn:incoming>Flow_29</bpmn:incoming>
      <bpmn:outgoing>Flow_32</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:serviceTask id="Task_NotifyScreening" name="Разослать приглашения на просмотр и напоминания">
      <bpmn:incoming>Flow_32</bpmn:incoming>
      <bpmn:outgoing>Flow_33</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:intermediateCatchEvent id="Event_Screen1Date" name="Зима: первый просмотр">
      <bpmn:incoming>Flow_33</bpmn:incoming>
      <bpmn:outgoing>Flow_34</bpmn:outgoing>
      <bpmn:timerEventDefinition id="Event_Screen1Date_def" />
    </bpmn:intermediateCatchEvent>
    <bpmn:userTask id="Task_Screening1" name="Просмотр № 1: оценка и комментарии в системе">
      <bpmn:documentation>Два преподавателя, не руководитель студента. В карточке просмотра — оценка, комментарий и контакт для консультации.</bpmn:documentation>
      <bpmn:incoming>Flow_34</bpmn:incoming>
      <bpmn:outgoing>Flow_39</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:boundaryEvent id="Boundary_Screen1" name="Окно закрылось" attachedToRef="Task_Screening1" cancelActivity="false">
      <bpmn:outgoing>Flow_35</bpmn:outgoing>
      <bpmn:timerEventDefinition id="Boundary_Screen1_def" />
    </bpmn:boundaryEvent>
    <bpmn:intermediateCatchEvent id="Event_Screen2Date" name="Весна: второй просмотр">
      <bpmn:incoming>Flow_39</bpmn:incoming>
      <bpmn:outgoing>Flow_40</bpmn:outgoing>
      <bpmn:timerEventDefinition id="Event_Screen2Date_def" />
    </bpmn:intermediateCatchEvent>
    <bpmn:userTask id="Task_Screening2" name="Просмотр № 2: оценка и комментарии в системе">
      <bpmn:incoming>Flow_40</bpmn:incoming>
      <bpmn:outgoing>Flow_41</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:boundaryEvent id="Boundary_Screen2" name="Окно закрылось" attachedToRef="Task_Screening2" cancelActivity="false">
      <bpmn:outgoing>Flow_36</bpmn:outgoing>
      <bpmn:timerEventDefinition id="Boundary_Screen2_def" />
    </bpmn:boundaryEvent>
    <bpmn:exclusiveGateway id="Gateway_LateMerge">
      <bpmn:incoming>Flow_35</bpmn:incoming>
      <bpmn:incoming>Flow_36</bpmn:incoming>
      <bpmn:outgoing>Flow_37</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:serviceTask id="Task_RemindLate" name="Напомнить студенту, преподавателю и замзаву">
      <bpmn:documentation>Окно просмотра — интервал дней. Если к его концу оценка не выставлена, трекер напоминает обеим сторонам и показывает просрочку заместителю заведующего.</bpmn:documentation>
      <bpmn:incoming>Flow_37</bpmn:incoming>
      <bpmn:outgoing>Flow_38</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:endEvent id="EndEvent_Reminded" name="Просрочка отработана">
      <bpmn:incoming>Flow_38</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:intermediateCatchEvent id="Event_BeforePredef" name="Март–апрель: за 1–2 месяца до предзащиты">
      <bpmn:incoming>Flow_41</bpmn:incoming>
      <bpmn:outgoing>Flow_42</bpmn:outgoing>
      <bpmn:timerEventDefinition id="Event_BeforePredef_def" />
    </bpmn:intermediateCatchEvent>
    <bpmn:userTask id="Task_UploadCode" name="Загрузить архив с кодом">
      <bpmn:documentation>Код сдаётся отдельным архивом: в пояснительную записку он не вкладывается.</bpmn:documentation>
      <bpmn:incoming>Flow_42</bpmn:incoming>
      <bpmn:outgoing>Flow_43</bpmn:outgoing>
      <bpmn:dataOutputAssociation id="DataOut_DataObj_CodeZip">
        <bpmn:targetRef>DataObj_CodeZip</bpmn:targetRef>
      </bpmn:dataOutputAssociation>
    </bpmn:userTask>
    <bpmn:serviceTask id="Task_LlmCodeReview" name="LLM-ревью кода: качество, стиль, соответствие заданию">
      <bpmn:documentation>Система распаковывает архив, разбирает проект и выдаёт замечания с привязкой к файлам и строкам.</bpmn:documentation>
      <bpmn:incoming>Flow_43</bpmn:incoming>
      <bpmn:outgoing>Flow_44</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:userTask id="Task_TeacherReviewCode" name="Проверить замечания и дополнить своими">
      <bpmn:incoming>Flow_44</bpmn:incoming>
      <bpmn:outgoing>Flow_45</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:userTask id="Task_FixCode" name="Устранить замечания по коду">
      <bpmn:incoming>Flow_45</bpmn:incoming>
      <bpmn:outgoing>Flow_46</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:userTask id="Task_PrepareDocs" name="Заполнить титульный лист и задание по шаблонам">
      <bpmn:incoming>Flow_46</bpmn:incoming>
      <bpmn:outgoing>Flow_47</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:userTask id="Task_UploadPdf" name="Выгрузить работу в PDF и отправить на проверку">
      <bpmn:documentation>Формат приёма единый — PDF: у большинства работа сделана в Word, у части в Typst или LaTeX.</bpmn:documentation>
      <bpmn:incoming>Flow_72</bpmn:incoming>
      <bpmn:outgoing>Flow_48</bpmn:outgoing>
      <bpmn:dataOutputAssociation id="DataOut_DataObj_Pdf">
        <bpmn:targetRef>DataObj_Pdf</bpmn:targetRef>
      </bpmn:dataOutputAssociation>
    </bpmn:userTask>
    <bpmn:serviceTask id="Task_ParseWork" name="Разобрать PDF: разделы, поля, шрифты, интервалы, ссылки на источники">
      <bpmn:documentation>Детерминированная часть проверки: состав и порядок разделов, поля страницы, кегль и интервал, нумерация, наличие ссылки в тексте на каждый источник.</bpmn:documentation>
      <bpmn:incoming>Flow_48</bpmn:incoming>
      <bpmn:outgoing>Flow_49</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:serviceTask id="Task_LlmNormControl" name="LLM-нормоконтроль: содержание разделов по методичке">
      <bpmn:documentation>LLM сверяет содержание с методичкой: обязательный минимум по разделам, связность, соответствие темы, задания и выводов.</bpmn:documentation>
      <bpmn:incoming>Flow_49</bpmn:incoming>
      <bpmn:outgoing>Flow_50</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:exclusiveGateway id="Gateway_NormOk" name="Замечания есть?">
      <bpmn:incoming>Flow_50</bpmn:incoming>
      <bpmn:outgoing>Flow_51</bpmn:outgoing>
      <bpmn:outgoing>Flow_52</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:userTask id="Task_FixNorm" name="Устранить замечания и пересобрать PDF">
      <bpmn:incoming>Flow_52</bpmn:incoming>
      <bpmn:outgoing>Flow_53</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:userTask id="Task_NormConfirm" name="Подтвердить результат проверки">
      <bpmn:incoming>Flow_51</bpmn:incoming>
      <bpmn:outgoing>Flow_54</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:userTask id="Task_Antiplagiat" name="Проверить на антиплагиат и выдать справку">
      <bpmn:documentation>Остаётся ручной проверкой нормоконтролёра; справка подписывается отдельно.</bpmn:documentation>
      <bpmn:incoming>Flow_71</bpmn:incoming>
      <bpmn:outgoing>Flow_55</bpmn:outgoing>
      <bpmn:dataOutputAssociation id="DataOut_DataObj_PlagReport">
        <bpmn:targetRef>DataObj_PlagReport</bpmn:targetRef>
      </bpmn:dataOutputAssociation>
    </bpmn:userTask>
    <bpmn:exclusiveGateway id="Gateway_PlagOk" name="Оригинальность достаточна?">
      <bpmn:incoming>Flow_55</bpmn:incoming>
      <bpmn:outgoing>Flow_56</bpmn:outgoing>
      <bpmn:outgoing>Flow_57</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:userTask id="Task_FixText" name="Доработать текст работы">
      <bpmn:incoming>Flow_57</bpmn:incoming>
      <bpmn:outgoing>Flow_58</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:serviceTask id="Task_CollectPackage" name="Собрать пакет документов">
      <bpmn:documentation>Титульный лист, задание и справка об антиплагиате собираются в системе; подписанный список литературы добавляется позже, перед сшиванием.</bpmn:documentation>
      <bpmn:incoming>Flow_56</bpmn:incoming>
      <bpmn:outgoing>Flow_59</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:intermediateCatchEvent id="Event_PredefDate" name="Май: предзащита">
      <bpmn:incoming>Flow_59</bpmn:incoming>
      <bpmn:outgoing>Flow_60</bpmn:outgoing>
      <bpmn:timerEventDefinition id="Event_PredefDate_def" />
    </bpmn:intermediateCatchEvent>
    <bpmn:userTask id="Task_Predefense" name="Предзащита: три преподавателя очно смотрят работу">
      <bpmn:incoming>Flow_70</bpmn:incoming>
      <bpmn:outgoing>Flow_61</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:exclusiveGateway id="Gateway_Admitted" name="Допущен к защите?">
      <bpmn:incoming>Flow_61</bpmn:incoming>
      <bpmn:outgoing>Flow_62</bpmn:outgoing>
      <bpmn:outgoing>Flow_65</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:userTask id="Task_FixAfterPre" name="Доработать по замечаниям предзащиты">
      <bpmn:incoming>Flow_65</bpmn:incoming>
      <bpmn:outgoing>Flow_66</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:sendTask id="Task_SendBibLibrary" name="Отправить список литературы в библиотеку">
      <bpmn:incoming>Flow_62</bpmn:incoming>
      <bpmn:outgoing>Flow_63</bpmn:outgoing>
    </bpmn:sendTask>
    <bpmn:intermediateCatchEvent id="Event_BibSigned" name="Список литературы подписан">
      <bpmn:incoming>Flow_63</bpmn:incoming>
      <bpmn:outgoing>Flow_64</bpmn:outgoing>
      <bpmn:messageEventDefinition id="Event_BibSigned_def" />
    </bpmn:intermediateCatchEvent>
    <bpmn:manualTask id="Task_BindWork" name="Сшить работу">
      <bpmn:incoming>Flow_64</bpmn:incoming>
      <bpmn:outgoing>Flow_67</bpmn:outgoing>
    </bpmn:manualTask>
    <bpmn:userTask id="Task_HeadSign" name="Подписать сшитую работу">
      <bpmn:incoming>Flow_67</bpmn:incoming>
      <bpmn:outgoing>Flow_68</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:userTask id="Task_Defense" name="Защита ВКР перед комиссией">
      <bpmn:incoming>Flow_68</bpmn:incoming>
      <bpmn:outgoing>Flow_69</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:endEvent id="EndEvent_Done" name="ВКР защищена, оценка выставлена">
      <bpmn:incoming>Flow_69</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:exclusiveGateway id="Gateway_PredefMerge">
      <bpmn:incoming>Flow_60</bpmn:incoming>
      <bpmn:incoming>Flow_66</bpmn:incoming>
      <bpmn:outgoing>Flow_70</bpmn:outgoing>
    </bpmn:exclusiveGateway>
