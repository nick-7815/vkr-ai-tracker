    <bpmn:sequenceFlow id="Flow_64" sourceRef="Event_BibSigned" targetRef="Task_BindWork" />
    <bpmn:sequenceFlow id="Flow_65" name="на доработку" sourceRef="Gateway_Admitted" targetRef="Task_FixAfterPre" />
    <bpmn:sequenceFlow id="Flow_66" sourceRef="Task_FixAfterPre" targetRef="Gateway_PredefMerge" />
    <bpmn:sequenceFlow id="Flow_67" sourceRef="Task_BindWork" targetRef="Task_HeadSign" />
    <bpmn:sequenceFlow id="Flow_68" sourceRef="Task_HeadSign" targetRef="Task_Defense" />
    <bpmn:sequenceFlow id="Flow_69" sourceRef="Task_Defense" targetRef="EndEvent_Done" />
    <bpmn:sequenceFlow id="Flow_70" sourceRef="Gateway_PredefMerge" targetRef="Task_Predefense" />
    <bpmn:sequenceFlow id="Flow_71" sourceRef="Gateway_PlagMerge" targetRef="Task_Antiplagiat" />
    <bpmn:sequenceFlow id="Flow_72" sourceRef="Gateway_PdfMerge" targetRef="Task_UploadPdf" />
    <bpmn:sequenceFlow id="Flow_73" sourceRef="Gateway_SourceMerge" targetRef="Task_AddSource" />
    <bpmn:sequenceFlow id="Flow_74" sourceRef="Gateway_OrderMerge" targetRef="Task_GenOrder" />
    <bpmn:textAnnotation id="Note_Deputy">
      <bpmn:text>Даты берутся из окон регламента; правки замзава пересчитывают сроки</bpmn:text>
    </bpmn:textAnnotation>
    <bpmn:textAnnotation id="Note_Submit">
      <bpmn:text>Второй круг: фамилия студента и формулировка для диплома</bpmn:text>
    </bpmn:textAnnotation>
    <bpmn:textAnnotation id="Note_Refchecker">
      <bpmn:text>Готовая строка вставляется и в Word, и в Typst — формат работы не важен</bpmn:text>
    </bpmn:textAnnotation>
    <bpmn:textAnnotation id="Note_RefRules">
      <bpmn:text>30+ источников, 20 % зарубежных, обязательные базы</bpmn:text>
    </bpmn:textAnnotation>
    <bpmn:textAnnotation id="Note_Screen">
      <bpmn:text>Оценка, комментарий и контакт фиксируются в карточке просмотра</bpmn:text>
    </bpmn:textAnnotation>
    <bpmn:textAnnotation id="Note_Window">
      <bpmn:text>Просмотр — окно в несколько дней: за это время студент и два преподавателя должны встретиться и выставить оценку</bpmn:text>
    </bpmn:textAnnotation>
    <bpmn:textAnnotation id="Note_PredefDay">
      <bpmn:text>Предзащита — один день, внутри слоты по времени</bpmn:text>
    </bpmn:textAnnotation>
    <bpmn:textAnnotation id="Note_LlmCode">
      <bpmn:text>Код приходит архивом; замечания LLM проверяет и дополняет руководитель</bpmn:text>
    </bpmn:textAnnotation>
    <bpmn:textAnnotation id="Note_Pdf">
      <bpmn:text>Единый вход — PDF: Word, Typst или LaTeX не различаются</bpmn:text>
    </bpmn:textAnnotation>
    <bpmn:textAnnotation id="Note_LlmNorm">
      <bpmn:text>Формальное — разбором PDF, содержательное — LLM по методичке</bpmn:text>
    </bpmn:textAnnotation>
    <bpmn:textAnnotation id="Note_NormConfirm">
      <bpmn:text>Нужен ли живой нормоконтролёр после LLM — открытый вопрос</bpmn:text>
    </bpmn:textAnnotation>
    <bpmn:textAnnotation id="Note_Plag">
      <bpmn:text>Антиплагиат остаётся ручной проверкой</bpmn:text>
    </bpmn:textAnnotation>
    <bpmn:textAnnotation id="Note_Tracker">
      <bpmn:text>Трекер ведёт статусы и сроки: напоминания студенту, руководителю и рецензентам</bpmn:text>
    </bpmn:textAnnotation>
