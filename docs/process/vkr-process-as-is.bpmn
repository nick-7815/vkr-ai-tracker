<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
                  xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL"
                  xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI"
                  xmlns:dc="http://www.omg.org/spec/DD/20100524/DC"
                  xmlns:di="http://www.omg.org/spec/DD/20100524/DI"
                  id="Definitions_VKR_AsIs" targetNamespace="http://bpmn.io/schema/bpmn"
                  exporter="docs/process/lib/bpmn-builder.js" exporterVersion="1.0">
  <bpmn:category id="Category_1">
    <bpmn:categoryValue id="CategoryValue_1" value="Этап 1. Таблица тем и подача студентов" />
  </bpmn:category>
  <bpmn:category id="Category_2">
    <bpmn:categoryValue id="CategoryValue_2" value="Этап 2. Проект приказа и приказ" />
  </bpmn:category>
  <bpmn:category id="Category_3">
    <bpmn:categoryValue id="CategoryValue_3" value="Этап 3. Работа над ВКР: библиография, просмотры, ревью кода" />
  </bpmn:category>
  <bpmn:category id="Category_4">
    <bpmn:categoryValue id="CategoryValue_4" value="Этап 4. Допуск: нормоконтроль и антиплагиат" />
  </bpmn:category>
  <bpmn:category id="Category_5">
    <bpmn:categoryValue id="CategoryValue_5" value="Этап 5. Предзащита, подписи и защита" />
  </bpmn:category>
  <bpmn:collaboration id="Collaboration_1">
    <bpmn:documentation>Сквозной процесс выпускной квалификационной работы: от таблицы тем до защиты.</bpmn:documentation>
    <bpmn:participant id="Participant_1" name="Кафедра: выполнение и защита ВКР" processRef="Process_1" />
    <bpmn:participant id="Participant_Rectorate" name="Ректорат: подписание приказа" />
    <bpmn:participant id="Participant_Library" name="Библиотека: проверка и подпись списка литературы" />
    <bpmn:messageFlow id="MessageFlow_OrderOut" name="Проект приказа на подпись" sourceRef="Task_SendOrder" targetRef="Participant_Rectorate" />
    <bpmn:messageFlow id="MessageFlow_OrderBack" name="Подписанный приказ или замечания" sourceRef="Participant_Rectorate" targetRef="Event_OrderReply" />
    <bpmn:messageFlow id="MessageFlow_BibOut" name="Список литературы" sourceRef="Task_SendBibLibrary" targetRef="Participant_Library" />
    <bpmn:messageFlow id="MessageFlow_BibBack" name="Подписанный список" sourceRef="Participant_Library" targetRef="Event_BibSigned" />
  </bpmn:collaboration>
  <bpmn:process id="Process_1" name="Выполнение и защита ВКР («как есть»)" isExecutable="false">
    <bpmn:documentation>Модель «как есть»: график цикла ведёт заместитель заведующего по учебной части, таблица тем на выбор, подача пары «студент — итоговая тема», проект приказа и приказ через ректорат, библиография, зимний и весенний просмотры, ревью кода, нормоконтроль и антиплагиат, майская предзащита, подпись списка литературы в библиотеке, сшивание, подпись заведующего и защита.</bpmn:documentation>
    <bpmn:laneSet id="LaneSet_1">
      <bpmn:lane id="Lane_Deputy" name="Заместитель заведующего по учебной части">
        <bpmn:flowNodeRef>StartEvent_Cycle</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_PlanCalendar</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_Secretary" name="Секретарь кафедры (таблица тем, приказ)">
        <bpmn:flowNodeRef>Task_OpenTable</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_ShareTable</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_DraftOrder</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_SendOrder</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Event_OrderReply</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gateway_Signed</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_ReturnForFix</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_PublishOrder</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Event_OrderPublished</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gateway_ReviewerMode</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_ShuffleReviewers</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gateway_ReviewerJoin</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gateway_OrderMerge</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_Teacher" name="Руководитель ВКР (преподаватель студента)">
        <bpmn:flowNodeRef>Task_CollectTopics</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_AdjustTopic</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_SubmitStudent</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_FixTopic</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_TeacherPick</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Event_BeforePredef</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_CodeReview</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_Student" name="Студент">
        <bpmn:flowNodeRef>Task_StudentReview</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gateway_TopicChoice</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_PickTopic</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_NewTopic</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gateway_TopicJoin</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>SubProcess_TopicChange</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Event_EndSemester</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_Bibliography</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_BibCheck</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gateway_BibOk</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_FixBib</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_FixCode</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_PrepareDocs</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_UploadWork</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_FixNorm</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_FixText</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_CollectPackage</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_FixAfterPre</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_SendBibLibrary</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Event_BibSigned</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_BindWork</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gateway_BibMerge</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_Norm" name="Нормоконтролёр (нормоконтроль и антиплагиат)">
        <bpmn:flowNodeRef>Task_NormControl</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gateway_NormOk</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_Antiplagiat</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gateway_PlagOk</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gateway_PlagMerge</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gateway_NormMerge</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_Head" name="Заведующий кафедрой">
        <bpmn:flowNodeRef>Task_HeadSign</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_Board" name="Другие преподаватели (просмотры, предзащита, защита)">
        <bpmn:flowNodeRef>Event_Screen1Date</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_Screening1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Event_Screen2Date</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_Screening2</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Event_PredefDate</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_Predefense</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gateway_Admitted</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_Defense</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>EndEvent_Done</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gateway_PredefMerge</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="StartEvent_Cycle" name="Начался новый учебный год">
      <bpmn:outgoing>Flow_1</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:userTask id="Task_PlanCalendar" name="Назначить даты просмотров, нормоконтроля и предзащиты">
      <bpmn:documentation>Заместитель заведующего по учебной части ведёт весь график: назначает даты, рассылает их по кафедре, торопит отстающих и собирает статусы вручную.</bpmn:documentation>
      <bpmn:incoming>Flow_1</bpmn:incoming>
      <bpmn:outgoing>Flow_2</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:userTask id="Task_OpenTable" name="Собрать таблицу преподавателей с дипломниками">
      <bpmn:documentation>В таблицу попадают преподаватели, у которых в этом году есть дипломники: каждый вписывает свои темы.</bpmn:documentation>
      <bpmn:incoming>Flow_2</bpmn:incoming>
      <bpmn:outgoing>Flow_3</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:userTask id="Task_CollectTopics" name="Вписать темы на выбор">
      <bpmn:documentation>Темы предлагаются студентам на выбор: новые идеи, задачи с основного места работы и темы прошлых лет — их обычно больше половины.</bpmn:documentation>
      <bpmn:incoming>Flow_3</bpmn:incoming>
      <bpmn:outgoing>Flow_4</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:sendTask id="Task_ShareTable" name="Разослать студентам ссылку на таблицу тем">
      <bpmn:incoming>Flow_4</bpmn:incoming>
      <bpmn:outgoing>Flow_5</bpmn:outgoing>
    </bpmn:sendTask>
    <bpmn:userTask id="Task_StudentReview" name="Изучить темы и связаться с преподавателем">
      <bpmn:incoming>Flow_5</bpmn:incoming>
      <bpmn:outgoing>Flow_6</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:exclusiveGateway id="Gateway_TopicChoice" name="Как определяется тема?">
      <bpmn:incoming>Flow_6</bpmn:incoming>
      <bpmn:outgoing>Flow_7</bpmn:outgoing>
      <bpmn:outgoing>Flow_8</bpmn:outgoing>
      <bpmn:outgoing>Flow_9</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:userTask id="Task_PickTopic" name="Выбрать тему из перечня">
      <bpmn:incoming>Flow_7</bpmn:incoming>
      <bpmn:outgoing>Flow_10</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:userTask id="Task_NewTopic" name="Предложить свою тему">
      <bpmn:incoming>Flow_8</bpmn:incoming>
      <bpmn:outgoing>Flow_11</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:userTask id="Task_AdjustTopic" name="Уточнить формулировку темы под специфику">
      <bpmn:documentation>Общая тема из перечня дорабатывается вместе со студентом под конкретную задачу.</bpmn:documentation>
      <bpmn:incoming>Flow_9</bpmn:incoming>
      <bpmn:outgoing>Flow_12</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:exclusiveGateway id="Gateway_TopicJoin">
      <bpmn:incoming>Flow_10</bpmn:incoming>
      <bpmn:incoming>Flow_11</bpmn:incoming>
      <bpmn:incoming>Flow_12</bpmn:incoming>
      <bpmn:outgoing>Flow_13</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:userTask id="Task_SubmitStudent" name="Подать студента и итоговую тему">
      <bpmn:documentation>Второй круг таблицы: преподаватель указывает фамилию студента и ту формулировку темы, которая пойдёт в диплом.</bpmn:documentation>
      <bpmn:incoming>Flow_13</bpmn:incoming>
      <bpmn:outgoing>Flow_14</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:userTask id="Task_DraftOrder" name="Сформировать проект приказа">
      <bpmn:documentation>Проект приказа собирается из поданных пар «студент — тема». До подписи это именно проект.</bpmn:documentation>
      <bpmn:incoming>Flow_67</bpmn:incoming>
      <bpmn:outgoing>Flow_15</bpmn:outgoing>
      <bpmn:dataOutputAssociation id="DataOut_DataObj_OrderDraft">
        <bpmn:targetRef>DataObj_OrderDraft</bpmn:targetRef>
      </bpmn:dataOutputAssociation>
    </bpmn:userTask>
    <bpmn:sendTask id="Task_SendOrder" name="Отправить проект приказа на подпись в ректорат">
      <bpmn:incoming>Flow_15</bpmn:incoming>
      <bpmn:outgoing>Flow_16</bpmn:outgoing>
    </bpmn:sendTask>
    <bpmn:intermediateCatchEvent id="Event_OrderReply" name="Ответ из ректората">
      <bpmn:incoming>Flow_16</bpmn:incoming>
      <bpmn:outgoing>Flow_17</bpmn:outgoing>
      <bpmn:messageEventDefinition id="Event_OrderReply_def" />
    </bpmn:intermediateCatchEvent>
    <bpmn:userTask id="Task_FixTopic" name="Исправить формулировку темы">
      <bpmn:incoming>Flow_20</bpmn:incoming>
      <bpmn:outgoing>Flow_21</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:exclusiveGateway id="Gateway_Signed" name="Проект подписан?">
      <bpmn:incoming>Flow_17</bpmn:incoming>
      <bpmn:outgoing>Flow_18</bpmn:outgoing>
      <bpmn:outgoing>Flow_19</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:userTask id="Task_ReturnForFix" name="Вернуть тему на доработку и проконтролировать срок">
      <bpmn:incoming>Flow_19</bpmn:incoming>
      <bpmn:outgoing>Flow_20</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:userTask id="Task_PublishOrder" name="Опубликовать приказ">
      <bpmn:documentation>После подписи проект становится приказом: темы и руководители закреплены.</bpmn:documentation>
      <bpmn:incoming>Flow_18</bpmn:incoming>
      <bpmn:outgoing>Flow_22</bpmn:outgoing>
      <bpmn:dataOutputAssociation id="DataOut_DataObj_Order">
        <bpmn:targetRef>DataObj_Order</bpmn:targetRef>
      </bpmn:dataOutputAssociation>
    </bpmn:userTask>
    <bpmn:intermediateThrowEvent id="Event_OrderPublished" name="Темы утверждены приказом">
      <bpmn:incoming>Flow_22</bpmn:incoming>
      <bpmn:outgoing>Flow_23</bpmn:outgoing>
    </bpmn:intermediateThrowEvent>
    <bpmn:subProcess id="SubProcess_TopicChange" name="Смена темы после приказа (по заявлению)" triggeredByEvent="true">
      <bpmn:startEvent id="SubProcess_TopicChange_S" name="Нужна смена темы" isInterrupting="false">
        <bpmn:outgoing>SubProcess_TopicChange_F1</bpmn:outgoing>
        <bpmn:messageEventDefinition id="SubProcess_TopicChange_S_def" />
      </bpmn:startEvent>
      <bpmn:userTask id="SubProcess_TopicChange_T1" name="Заполнить и подать заявление на смену темы">
        <bpmn:incoming>SubProcess_TopicChange_F1</bpmn:incoming>
        <bpmn:outgoing>SubProcess_TopicChange_F2</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="SubProcess_TopicChange_T2" name="Согласовать новую тему с руководителем">
        <bpmn:incoming>SubProcess_TopicChange_F2</bpmn:incoming>
        <bpmn:outgoing>SubProcess_TopicChange_F3</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:userTask id="SubProcess_TopicChange_T3" name="Внести изменение в приказ">
        <bpmn:incoming>SubProcess_TopicChange_F3</bpmn:incoming>
        <bpmn:outgoing>SubProcess_TopicChange_F4</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:endEvent id="SubProcess_TopicChange_E" name="Тема изменена">
        <bpmn:incoming>SubProcess_TopicChange_F4</bpmn:incoming>
      </bpmn:endEvent>
      <bpmn:sequenceFlow id="SubProcess_TopicChange_F1" sourceRef="SubProcess_TopicChange_S" targetRef="SubProcess_TopicChange_T1" />
      <bpmn:sequenceFlow id="SubProcess_TopicChange_F2" sourceRef="SubProcess_TopicChange_T1" targetRef="SubProcess_TopicChange_T2" />
      <bpmn:sequenceFlow id="SubProcess_TopicChange_F3" sourceRef="SubProcess_TopicChange_T2" targetRef="SubProcess_TopicChange_T3" />
      <bpmn:sequenceFlow id="SubProcess_TopicChange_F4" sourceRef="SubProcess_TopicChange_T3" targetRef="SubProcess_TopicChange_E" />
    </bpmn:subProcess>
    <bpmn:intermediateCatchEvent id="Event_EndSemester" name="Конец первого семестра">
      <bpmn:incoming>Flow_23</bpmn:incoming>
      <bpmn:outgoing>Flow_24</bpmn:outgoing>
      <bpmn:timerEventDefinition id="Event_EndSemester_def" />
    </bpmn:intermediateCatchEvent>
    <bpmn:userTask id="Task_Bibliography" name="Оформить список литературы по требованиям вуза">
      <bpmn:incoming>Flow_24</bpmn:incoming>
      <bpmn:outgoing>Flow_25</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:serviceTask id="Task_BibCheck" name="Автопроверка оформления и признаков генерации источников">
      <bpmn:incoming>Flow_66</bpmn:incoming>
      <bpmn:outgoing>Flow_26</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:exclusiveGateway id="Gateway_BibOk" name="Оформление корректно?">
      <bpmn:incoming>Flow_26</bpmn:incoming>
      <bpmn:outgoing>Flow_27</bpmn:outgoing>
      <bpmn:outgoing>Flow_28</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:userTask id="Task_FixBib" name="Исправить список литературы">
      <bpmn:incoming>Flow_28</bpmn:incoming>
      <bpmn:outgoing>Flow_29</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:exclusiveGateway id="Gateway_ReviewerMode" name="Как подобрать рецензентов?">
      <bpmn:incoming>Flow_27</bpmn:incoming>
      <bpmn:outgoing>Flow_30</bpmn:outgoing>
      <bpmn:outgoing>Flow_31</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:serviceTask id="Task_ShuffleReviewers" name="Подобрать рецензентов случайно, без повторов">
      <bpmn:incoming>Flow_30</bpmn:incoming>
      <bpmn:outgoing>Flow_32</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:userTask id="Task_TeacherPick" name="Указать предпочтительных рецензентов">
      <bpmn:incoming>Flow_31</bpmn:incoming>
      <bpmn:outgoing>Flow_33</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:exclusiveGateway id="Gateway_ReviewerJoin">
      <bpmn:incoming>Flow_32</bpmn:incoming>
      <bpmn:incoming>Flow_33</bpmn:incoming>
      <bpmn:outgoing>Flow_34</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:intermediateCatchEvent id="Event_Screen1Date" name="Зима: первый просмотр">
      <bpmn:incoming>Flow_34</bpmn:incoming>
      <bpmn:outgoing>Flow_35</bpmn:outgoing>
      <bpmn:timerEventDefinition id="Event_Screen1Date_def" />
    </bpmn:intermediateCatchEvent>
    <bpmn:userTask id="Task_Screening1" name="Просмотр № 1: оценка и комментарии двух преподавателей">
      <bpmn:documentation>Двое преподавателей, не руководитель студента: комментарий, оценка и контакт — куда и когда подойти.</bpmn:documentation>
      <bpmn:incoming>Flow_35</bpmn:incoming>
      <bpmn:outgoing>Flow_36</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:intermediateCatchEvent id="Event_Screen2Date" name="Весна: второй просмотр">
      <bpmn:incoming>Flow_36</bpmn:incoming>
      <bpmn:outgoing>Flow_37</bpmn:outgoing>
      <bpmn:timerEventDefinition id="Event_Screen2Date_def" />
    </bpmn:intermediateCatchEvent>
    <bpmn:userTask id="Task_Screening2" name="Просмотр № 2: оценка и комментарии двух преподавателей">
      <bpmn:documentation>Состав второго просмотра не повторяет первый.</bpmn:documentation>
      <bpmn:incoming>Flow_37</bpmn:incoming>
      <bpmn:outgoing>Flow_38</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:intermediateCatchEvent id="Event_BeforePredef" name="Март–апрель: за 1–2 месяца до предзащиты">
      <bpmn:incoming>Flow_38</bpmn:incoming>
      <bpmn:outgoing>Flow_39</bpmn:outgoing>
      <bpmn:timerEventDefinition id="Event_BeforePredef_def" />
    </bpmn:intermediateCatchEvent>
    <bpmn:userTask id="Task_CodeReview" name="Провести ревью кода и выдать замечания">
      <bpmn:incoming>Flow_39</bpmn:incoming>
      <bpmn:outgoing>Flow_40</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:userTask id="Task_FixCode" name="Устранить замечания по коду">
      <bpmn:incoming>Flow_40</bpmn:incoming>
      <bpmn:outgoing>Flow_41</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:userTask id="Task_PrepareDocs" name="Заполнить титульный лист и задание по шаблонам">
      <bpmn:incoming>Flow_41</bpmn:incoming>
      <bpmn:outgoing>Flow_42</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:userTask id="Task_UploadWork" name="Загрузить работу на нормоконтроль">
      <bpmn:incoming>Flow_42</bpmn:incoming>
      <bpmn:outgoing>Flow_43</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:userTask id="Task_NormControl" name="Нормоконтроль: метаданные, разделы, оформление, код">
      <bpmn:documentation>Проверка по методичке: поля и метаданные, состав и связность разделов, обязательный минимум содержания, оформление кода.</bpmn:documentation>
      <bpmn:incoming>Flow_65</bpmn:incoming>
      <bpmn:outgoing>Flow_44</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:exclusiveGateway id="Gateway_NormOk" name="Замечания устранены?">
      <bpmn:incoming>Flow_44</bpmn:incoming>
      <bpmn:outgoing>Flow_45</bpmn:outgoing>
      <bpmn:outgoing>Flow_46</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:userTask id="Task_FixNorm" name="Устранить замечания нормоконтроля">
      <bpmn:incoming>Flow_46</bpmn:incoming>
      <bpmn:outgoing>Flow_47</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:userTask id="Task_Antiplagiat" name="Проверить работу на антиплагиат и выдать справку">
      <bpmn:documentation>Проверку выполняет нормоконтролёр вручную; справка подписывается отдельно и прикладывается к работе.</bpmn:documentation>
      <bpmn:incoming>Flow_64</bpmn:incoming>
      <bpmn:outgoing>Flow_48</bpmn:outgoing>
      <bpmn:dataOutputAssociation id="DataOut_DataObj_PlagReport">
        <bpmn:targetRef>DataObj_PlagReport</bpmn:targetRef>
      </bpmn:dataOutputAssociation>
    </bpmn:userTask>
    <bpmn:exclusiveGateway id="Gateway_PlagOk" name="Оригинальность достаточна?">
      <bpmn:incoming>Flow_48</bpmn:incoming>
      <bpmn:outgoing>Flow_49</bpmn:outgoing>
      <bpmn:outgoing>Flow_50</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:userTask id="Task_FixText" name="Доработать текст работы">
      <bpmn:incoming>Flow_50</bpmn:incoming>
      <bpmn:outgoing>Flow_51</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:userTask id="Task_CollectPackage" name="Собрать пакет документов">
      <bpmn:documentation>Титульный лист, задание, справка об антиплагиате. Подписанный список литературы добавляется позже, перед сшиванием.</bpmn:documentation>
      <bpmn:incoming>Flow_49</bpmn:incoming>
      <bpmn:outgoing>Flow_52</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:intermediateCatchEvent id="Event_PredefDate" name="Май: предзащита">
      <bpmn:incoming>Flow_52</bpmn:incoming>
      <bpmn:outgoing>Flow_53</bpmn:outgoing>
      <bpmn:timerEventDefinition id="Event_PredefDate_def" />
    </bpmn:intermediateCatchEvent>
    <bpmn:userTask id="Task_Predefense" name="Предзащита: три преподавателя очно смотрят работу">
      <bpmn:incoming>Flow_63</bpmn:incoming>
      <bpmn:outgoing>Flow_54</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:exclusiveGateway id="Gateway_Admitted" name="Допущен к защите?">
      <bpmn:incoming>Flow_54</bpmn:incoming>
      <bpmn:outgoing>Flow_55</bpmn:outgoing>
      <bpmn:outgoing>Flow_58</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:userTask id="Task_FixAfterPre" name="Доработать работу по замечаниям предзащиты">
      <bpmn:incoming>Flow_58</bpmn:incoming>
      <bpmn:outgoing>Flow_59</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:sendTask id="Task_SendBibLibrary" name="Отправить список литературы в библиотеку">
      <bpmn:incoming>Flow_55</bpmn:incoming>
      <bpmn:outgoing>Flow_56</bpmn:outgoing>
    </bpmn:sendTask>
    <bpmn:intermediateCatchEvent id="Event_BibSigned" name="Список литературы подписан">
      <bpmn:incoming>Flow_56</bpmn:incoming>
      <bpmn:outgoing>Flow_57</bpmn:outgoing>
      <bpmn:dataOutputAssociation id="DataOut_DataObj_BibSigned">
        <bpmn:targetRef>DataObj_BibSigned</bpmn:targetRef>
      </bpmn:dataOutputAssociation>
      <bpmn:messageEventDefinition id="Event_BibSigned_def" />
    </bpmn:intermediateCatchEvent>
    <bpmn:manualTask id="Task_BindWork" name="Сшить работу">
      <bpmn:incoming>Flow_57</bpmn:incoming>
      <bpmn:outgoing>Flow_60</bpmn:outgoing>
    </bpmn:manualTask>
    <bpmn:userTask id="Task_HeadSign" name="Подписать сшитую работу">
      <bpmn:documentation>Заведующий кафедрой подписывает уже сшитую работу, перед защитой.</bpmn:documentation>
      <bpmn:incoming>Flow_60</bpmn:incoming>
      <bpmn:outgoing>Flow_61</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:userTask id="Task_Defense" name="Защита ВКР перед комиссией">
      <bpmn:incoming>Flow_61</bpmn:incoming>
      <bpmn:outgoing>Flow_62</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:endEvent id="EndEvent_Done" name="ВКР защищена, оценка выставлена">
      <bpmn:incoming>Flow_62</bpmn:incoming>
    </bpmn:endEvent>
