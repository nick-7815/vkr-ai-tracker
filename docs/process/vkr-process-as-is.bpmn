    <bpmn:textAnnotation id="Note_Deputy">
      <bpmn:text>График, напоминания и сбор статусов — вручную</bpmn:text>
    </bpmn:textAnnotation>
    <bpmn:textAnnotation id="Note_Topics">
      <bpmn:text>Первый круг таблицы: темы на выбор, без фамилий студентов</bpmn:text>
    </bpmn:textAnnotation>
    <bpmn:textAnnotation id="Note_Submit">
      <bpmn:text>Второй круг: фамилия студента и формулировка, которая пойдёт в диплом</bpmn:text>
    </bpmn:textAnnotation>
    <bpmn:textAnnotation id="Note_Change">
      <bpmn:text>После приказа тему меняют только по письменному заявлению</bpmn:text>
    </bpmn:textAnnotation>
    <bpmn:textAnnotation id="Note_Bib">
      <bpmn:text>Библиография сдаётся в конце первого семестра</bpmn:text>
    </bpmn:textAnnotation>
    <bpmn:textAnnotation id="Note_Reviewers">
      <bpmn:text>Рецензенты — преподаватели, не ведущие этого студента</bpmn:text>
    </bpmn:textAnnotation>
    <bpmn:textAnnotation id="Note_Screen">
      <bpmn:text>Оценка, комментарий и контакт: куда и когда подойти</bpmn:text>
    </bpmn:textAnnotation>
    <bpmn:textAnnotation id="Note_Window">
      <bpmn:text>Просмотр — окно в несколько дней: за это время студент и преподаватели должны встретиться; за просрочкой следит замзав вручную</bpmn:text>
    </bpmn:textAnnotation>
    <bpmn:textAnnotation id="Note_PredefDay">
      <bpmn:text>Предзащита — один день, внутри слоты по времени</bpmn:text>
    </bpmn:textAnnotation>
    <bpmn:textAnnotation id="Note_Norm">
      <bpmn:text>Сейчас вручную; проверку по методичке планируется отдать LLM</bpmn:text>
    </bpmn:textAnnotation>
    <bpmn:textAnnotation id="Note_Plag">
      <bpmn:text>Антиплагиат остаётся ручной проверкой нормоконтролёра</bpmn:text>
    </bpmn:textAnnotation>
    <bpmn:textAnnotation id="Note_Templates">
      <bpmn:text>Шаблоны титульного листа и задания — на сайте или в боте</bpmn:text>
    </bpmn:textAnnotation>
    <bpmn:textAnnotation id="Note_HeadSign">
      <bpmn:text>Подпись — после предзащиты и сшивания, перед защитой</bpmn:text>
    </bpmn:textAnnotation>
    <bpmn:association id="Association_1" sourceRef="Task_PlanCalendar" targetRef="Note_Deputy" />
    <bpmn:association id="Association_2" sourceRef="Task_CollectTopics" targetRef="Note_Topics" />
